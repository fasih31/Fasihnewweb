{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx vite build && node --import tsx scripts/vercel-pages.ts",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/contact/delivery",
      "destination": "/api/contact-delivery"
    },
    {
      "source": "/guide/query",
      "destination": "/api/portfolio-answer"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://fasihnewweb.onrender.com/sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://fasihnewweb.onrender.com/api/:path*"
    },
    {
      "source": "/attached_assets/:path*",
      "destination": "https://fasihnewweb.onrender.com/attached_assets/:path*"
    },
    {
      "source": "/admin",
      "destination": "/app"
    },
    {
      "source": "/blog/:slug",
      "destination": "/app"
    }
  ],
  "redirects": [
    {
      "source": "/solutions/daas",
      "destination": "/domains/telecom",
      "permanent": true
    },
    {
      "source": "/solutions/edtech",
      "destination": "/domains/edtech",
      "permanent": true
    },
    {
      "source": "/solutions/fintech",
      "destination": "/domains/fintech",
      "permanent": true
    },
    {
      "source": "/solutions/ecommerce",
      "destination": "/domains/ecommerce",
      "permanent": true
    },
    {
      "source": "/project/1",
      "destination": "/work/virtualiec",
      "permanent": true
    },
    {
      "source": "/project/2",
      "destination": "/domains/crypto-web3",
      "permanent": true
    },
    {
      "source": "/project/3",
      "destination": "/domains/ai-ml",
      "permanent": true
    },
    {
      "source": "/project/4",
      "destination": "/domains/fintech",
      "permanent": true
    },
    {
      "source": "/project/5",
      "destination": "/domains/edtech",
      "permanent": true
    },
    {
      "source": "/project/6",
      "destination": "/domains/ecommerce",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
